# T13 deploy slice 1 - example environment for local container evidence.
# Copy to deploy/.env (git-ignored) and generate every value at runtime.
# NEVER commit a real .env, secret, key, token, or password.
# This template contains no runtime values; local deploy/.env remains ignored.

# ---- Pinned image references -------------------------------------------------
# Fixed non-floating tags by default. For full digest pinning replace any value
# with name@sha256:<digest> form and record the change in README section
# "Image digest update procedure". Digest verification is still an open item.
MAVEN_BUILD_IMAGE=maven:3.9.9-eclipse-temurin-17
JRE_RUNTIME_IMAGE=eclipse-temurin:17.0.12_7-jre-jammy
NODE_BUILD_IMAGE=node:22.14.0-alpine
NGINX_RUNTIME_IMAGE=nginxinc/nginx-unprivileged:1.27.4-alpine
MYSQL_IMAGE=mysql:8.0.40
REDIS_IMAGE=redis:7.4.9
API_IMAGE_TAG=local
EDGE_IMAGE_TAG=local

# ---- Host publishing (local vs external gate) --------------------------------
# LOCAL default: loopback bind, HTTP host port 80. Keep as-is for local/container
# evidence. EXTERNAL: any other bind/port or a 443 listener requires explicit
# user authorization per tasks 8.1-8.2; see README "Certificates".
EDGE_HTTP_BIND=127.0.0.1
EDGE_HTTP_PORT=80

# ---- Secrets (placeholders ONLY - generate real values locally) --------------
# DB_USERNAME/DB_PASSWORD feed BOTH the MySQL container's account creation
# (first init only, together with MYSQL_DATABASE=booking_db in compose.yml)
# and the API datasource. Generate real values locally before any run.
MYSQL_ROOT_PASSWORD=<generate-at-runtime>
DB_USERNAME=<generate-at-runtime-least-privilege-user>
DB_PASSWORD=<generate-at-runtime>
JWT_SECRET=<generate-at-runtime-min-32-bytes>
# Empty means Redis runs passwordless on the private network; set only if your
# local run adds auth.
REDIS_PASSWORD=

# ---- Runtime API configuration (non-secret constants) ------------------------
SPRINGDOC_ENABLED=false
# Independent optional capabilities. Cache is enabled in the local validation
# profile; operation log, notifications and statistics remain opt-in.
BOOKING_OPERATION_LOG_ENABLED=false
BOOKING_CACHE_ENABLED=true
BOOKING_NOTIFICATIONS_ENABLED=false
BOOKING_STATISTICS_ENABLED=false

# ---- TLS / renewal placeholders ---------------------------------------------
# TLS_HOST=<authorized-domain-or-ip>
# TLS_CERT_MOUNT=<path-provided-by-operator>
# TLS_RENEW_CMD=<documented-by-operator-renewal-runbook>
